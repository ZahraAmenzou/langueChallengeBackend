PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tachelhit_challenge
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tachelhit_challenge
JWT_SECRET=replace_with_a_long_random_string
# Comma-separated list of allowed frontend origins (MUST include the https:// scheme).
# The backend also auto-allows any subdomain of an allowed host, so Vercel preview
# deploy URLs like <hash>-<user>-projects.vercel.app work automatically.
# Examples:
#   CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
#   CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=production
